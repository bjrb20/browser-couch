# Copy to sofa-link.env (it is not committed) or paste into the Portainer
# stack's environment variables. Every value here is a placeholder.

# Room code that players type, at least 8 characters. Required.
SOFA_PIN=
# PIN for choosing and stopping games, at least 6 characters, not the room code. Required.
SOFA_ADMIN_PIN=

# Host folders, mounted read-only. The library has one subfolder per console (ps1, ps2).
# The BIOS folder has the same layout as runtime/system: PS1 BIOS files at the
# top, PS2 BIOS files in pcsx2/bios/.
SOFA_GAMES=/path/to/games
SOFA_BIOS=/path/to/bios
# The host user that owns those files (id -u, id -g).
SOFA_UID=1000
SOFA_GID=1000

# The HTTPS reverse proxy's address, as the game host sees it: the proxy's
# LAN address. Comma-separated IPs or CIDRs.
SOFA_TRUSTED_PROXY=192.0.2.1

# The relay's public name and the TLS port the reverse proxy listens on for it.
SOFA_TURN_PUBLIC_HOST=turn.example.org
SOFA_TURN_PUBLIC_PORT=5349
# Optional: also offer LAN browsers the relay's plain TCP port at this address.
SOFA_TURN_LAN_HOST=
# Set to 1 for one start to make a new relay password.
SOFA_TURN_NEW_PASSWORD=

# Published ports on the Docker host, TCP only.
SOFA_BIND=0.0.0.0
SOFA_WEB_PORT=8081
SOFA_TURN_PORT=3478

# The stack's own network: SOFA_SUBNET.0/29. Change it if it is in use.
SOFA_SUBNET=172.31.251
SOFA_CPUS=4
SOFA_MEMORY=4g
# Set to no to skip the console boot screens by default.
SOFA_BOOT_SCREEN=yes

# Off unless set. Online cover art and details, fetched when an admin asks:
# libretro (no account), screenscraper or igdb (each needs the credentials
# below), or several in the order to try them, for example libretro,igdb.
SOFA_METADATA=
# ScreenScraper: developer credentials (requested on its forum) and your user account.
SOFA_SCREENSCRAPER_DEVID=
SOFA_SCREENSCRAPER_DEVPASSWORD=
SOFA_SCREENSCRAPER_USER=
SOFA_SCREENSCRAPER_PASSWORD=
# IGDB: a Twitch developer application's client id and secret.
SOFA_IGDB_CLIENT_ID=
SOFA_IGDB_CLIENT_SECRET=
